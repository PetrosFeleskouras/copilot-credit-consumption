{
  "properties": {
    "connectionReferences": {
      "shared_webcontents": { "runtimeSource": "embedded", "connection": { "connectionReferenceLogicalName": "ccsync_webref" }, "api": { "name": "shared_webcontents" } },
      "shared_webcontents_1": { "runtimeSource": "embedded", "connection": { "connectionReferenceLogicalName": "ccsync_bapref" }, "api": { "name": "shared_webcontents" } },
      "shared_webcontents_2": { "runtimeSource": "embedded", "connection": { "connectionReferenceLogicalName": "ccsync_dvhttpref" }, "api": { "name": "shared_webcontents" } },
      "shared_commondataserviceforapps": { "runtimeSource": "embedded", "connection": { "connectionReferenceLogicalName": "ccsync_dvref" }, "api": { "name": "shared_commondataserviceforapps" } }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": { "$connections": { "defaultValue": {}, "type": "Object" }, "$authentication": { "defaultValue": {}, "type": "SecureObject" } },
      "triggers": { "Recurrence": { "type": "Recurrence", "recurrence": { "frequency": "Day", "interval": 1, "timeZone": "UTC", "schedule": { "hours": ["3"], "minutes": [0] } }, "runtimeConfiguration": { "concurrency": { "runs": 1 } } } },
      "actions": {
        "Get_Environments": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents_1", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "GET", "request/url": "https://api.powerplatform.com/environmentmanagement/environments?api-version=2024-10-01" }, "authentication": "@parameters('$authentication')" }, "runAfter": {} },
        "Compose_CurrentEnvId": { "type": "Compose", "inputs": "@workflow()?['tags']?['environmentName']", "runAfter": { "Get_Environments": ["Succeeded"] } },
        "Filter_CurrentEnv": { "type": "Query", "inputs": { "from": "@coalesce(body('Get_Environments')?['value'], json('[]'))", "where": "@equals(item()?['id'], outputs('Compose_CurrentEnvId'))" }, "runAfter": { "Compose_CurrentEnvId": ["Succeeded"] } },
        "Compose_Org": { "type": "Compose", "inputs": "@first(body('Filter_CurrentEnv'))?['url']", "runAfter": { "Filter_CurrentEnv": ["Succeeded"] } },
        "Compose_Tenant_Id": { "type": "Compose", "inputs": "@coalesce(first(body('Filter_CurrentEnv'))?['tenantId'], first(body('Get_Environments')?['value'])?['tenantId'])", "runAfter": { "Compose_Org": ["Succeeded"] } },
        "Compose_Batch": { "type": "Compose", "inputs": "@utcNow()", "runAfter": { "Compose_Tenant_Id": ["Succeeded"] } },
        "Compose_ToDate": { "type": "Compose", "inputs": "@formatDateTime(utcNow(), 'yyyy-MM-dd')", "runAfter": { "Compose_Batch": ["Succeeded"] } },
        "Compose_CRLF": { "type": "Compose", "inputs": "@decodeUriComponent('%0D%0A')", "runAfter": { "Compose_ToDate": ["Succeeded"] } },
        "Get_Sync_Metadata": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "ListRecords", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_syncmetadatas", "$filter": "cat_syncmetadata_name eq 'default'", "$top": 1 }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Compose_CRLF": ["Succeeded"] } },
        "Ensure_Metadata": { "type": "If", "expression": { "and": [ { "equals": [ "@empty(outputs('Get_Sync_Metadata')?['body/value'])", true ] } ] }, "runAfter": { "Get_Sync_Metadata": ["Succeeded"] }, "actions": { "Create_Default_Metadata": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "CreateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_syncmetadatas", "item/cat_syncmetadata_name": "default" }, "authentication": "@parameters('$authentication')" }, "runAfter": {} } }, "else": { "actions": {} } },
        "Compose_Sync_Id": { "type": "Compose", "inputs": "@coalesce(first(outputs('Get_Sync_Metadata')?['body/value'])?['cat_syncmetadataid'], body('Create_Default_Metadata')?['cat_syncmetadataid'])", "runAfter": { "Ensure_Metadata": ["Succeeded"] } },
        "Set_Status_Running": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_syncmetadatas", "recordId": "@{outputs('Compose_Sync_Id')}", "item/cat_lastsyncstatus": 3, "item/cat_lastsyncmessage": "Agent sync started" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Compose_Sync_Id": ["Succeeded"] } },
        "Init_ContDay": { "type": "InitializeVariable", "inputs": { "variables": [ { "name": "varContDay", "type": "string", "value": "" } ] }, "runAfter": { "Set_Status_Running": ["Succeeded"] } },
        "Init_DelDone": { "type": "InitializeVariable", "inputs": { "variables": [ { "name": "varDelDone", "type": "boolean", "value": false } ] }, "runAfter": { "Init_ContDay": ["Succeeded"] } },
        "Init_Seen": { "type": "InitializeVariable", "inputs": { "variables": [ { "name": "varSeen", "type": "array", "value": [] } ] }, "runAfter": { "Init_DelDone": ["Succeeded"] } },
        "Init_SeenTmp": { "type": "InitializeVariable", "inputs": { "variables": [ { "name": "varSeenTmp", "type": "array", "value": [] } ] }, "runAfter": { "Init_Seen": ["Succeeded"] } },
        "Init_EnvMap": { "type": "InitializeVariable", "inputs": { "variables": [ { "name": "varEnvMap", "type": "object", "value": {} } ] }, "runAfter": { "Init_SeenTmp": ["Succeeded"] } },
        "Build_EnvMap": {
          "type": "Scope", "runAfter": { "Init_EnvMap": ["Succeeded"] },
          "actions": {
            "Select_Env_Pairs": { "type": "Select", "inputs": { "from": "@coalesce(body('Get_Environments')?['value'], json('[]'))", "select": "@concat('\"', item()?['id'], '\":\"', replace(replace(replace(replace(coalesce(item()?['displayName'],''), '\\', ''), '\"', ''), decodeUriComponent('%0D'), ''), decodeUriComponent('%0A'), ''), '\"')" }, "runAfter": {} },
            "Compose_EnvMap": { "type": "Compose", "inputs": "@json(concat('{', join(body('Select_Env_Pairs'), ','), '}'))", "runAfter": { "Select_Env_Pairs": ["Succeeded"] } },
            "Set_EnvMap": { "type": "SetVariable", "inputs": { "name": "varEnvMap", "value": "@outputs('Compose_EnvMap')" }, "runAfter": { "Compose_EnvMap": ["Succeeded"] } }
          }
        },
        "Process": {
          "type": "Scope", "runAfter": { "Build_EnvMap": ["Succeeded", "Failed", "Skipped"] },
          "actions": {
            "Get_Capacity_MCS": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "GET", "request/url": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', outputs('Compose_Tenant_Id'), '/entitlements/MCSMessages')}" }, "authentication": "@parameters('$authentication')" }, "runAfter": {} },
            "Compose_EndDay": { "type": "Compose", "inputs": "@if(empty(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['lastUpdatedOn']), formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd'), formatDateTime(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['lastUpdatedOn'], 'yyyy-MM-dd'))", "runAfter": { "Get_Capacity_MCS": ["Succeeded"] } },
            "Check_Existing": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents_2", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "GET", "request/url": "@{concat(outputs('Compose_Org'), '/api/data/v9.2/cat_agentdetails?$select=cat_agentdetailid&$top=1&$filter=cat_lookbackdays%20eq%201')}" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Compose_EndDay": ["Succeeded"] } },
            "Compose_WindowDays": { "type": "Compose", "inputs": "@if(equals(length(coalesce(body('Check_Existing')?['value'], json('[]'))), 0), 180, 7)", "runAfter": { "Check_Existing": ["Succeeded"] } },
            "Compose_StartDay": { "type": "Compose", "inputs": "@formatDateTime(addDays(outputs('Compose_EndDay'), sub(1, outputs('Compose_WindowDays'))), 'yyyy-MM-dd')", "runAfter": { "Compose_WindowDays": ["Succeeded"] } },
            "Delete_Window": { "type": "Scope", "runAfter": { "Compose_StartDay": ["Succeeded"] }, "actions": {
              "Compose_DelBaseUrl": { "type": "Compose", "inputs": "@{concat(outputs('Compose_Org'), '/api/data/v9.2/cat_agentdetails?$select=cat_agentdetailid&$filter=cat_lookbackdays%20eq%201%20and%20cat_reportdate%20ge%20', outputs('Compose_StartDay'), 'T00:00:00Z%20and%20cat_reportdate%20lt%20', formatDateTime(addDays(outputs('Compose_EndDay'), 1), 'yyyy-MM-dd'), 'T00:00:00Z')}", "runAfter": {} },
              "Until_Delete": { "type": "Until", "expression": "@equals(variables('varDelDone'), true)", "limit": { "count": 500, "timeout": "PT1H" }, "runAfter": { "Compose_DelBaseUrl": ["Succeeded"] }, "actions": {
                "Get_DelPage": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents_2", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "GET", "request/url": "@{outputs('Compose_DelBaseUrl')}", "request/headers": { "Prefer": "odata.maxpagesize=500" } }, "authentication": "@parameters('$authentication')" }, "runAfter": {} },
                "If_Del_Rows": { "type": "If", "expression": { "and": [ { "greater": [ "@length(coalesce(body('Get_DelPage')?['value'], json('[]')))", 0 ] } ] }, "runAfter": { "Get_DelPage": ["Succeeded"] }, "actions": {
                  "DelParts": { "type": "Select", "inputs": { "from": "@body('Get_DelPage')?['value']", "select": "@concat('--changesetB', outputs('Compose_CRLF'), 'Content-Type: application/http', outputs('Compose_CRLF'), 'Content-Transfer-Encoding: binary', outputs('Compose_CRLF'), 'Content-ID: ', guid(), outputs('Compose_CRLF'), outputs('Compose_CRLF'), 'DELETE ', outputs('Compose_Org'), '/api/data/v9.2/cat_agentdetails(', item()?['cat_agentdetailid'], ') HTTP/1.1', outputs('Compose_CRLF'))" }, "runAfter": {} },
                  "DelBody": { "type": "Compose", "inputs": "@concat('--batchB', outputs('Compose_CRLF'), 'Content-Type: multipart/mixed; boundary=changesetB', outputs('Compose_CRLF'), outputs('Compose_CRLF'), join(body('DelParts'), outputs('Compose_CRLF')), outputs('Compose_CRLF'), '--changesetB--', outputs('Compose_CRLF'), '--batchB--')", "runAfter": { "DelParts": ["Succeeded"] } },
                  "Post_Del": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents_2", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "POST", "request/url": "@{concat(outputs('Compose_Org'), '/api/data/v9.2/$batch')}", "request/headers": { "Content-Type": "multipart/mixed; boundary=batchB" }, "request/body": "@outputs('DelBody')" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "DelBody": ["Succeeded"] } }
                }, "else": { "actions": {
                  "Set_DelDone": { "type": "SetVariable", "inputs": { "name": "varDelDone", "value": true }, "runAfter": {} }
                } } }
              } }
            } },
            "Insert_Days": { "type": "Scope", "runAfter": { "Delete_Window": ["Succeeded"] }, "actions": {
              "Compose_Days": { "type": "Select", "inputs": { "from": "@range(0, outputs('Compose_WindowDays'))", "select": "@formatDateTime(addDays(outputs('Compose_StartDay'), item()), 'yyyy-MM-dd')" }, "runAfter": {} },
              "Apply_to_each_Day": { "type": "Foreach", "foreach": "@body('Compose_Days')", "runtimeConfiguration": { "concurrency": { "repetitions": 1 } }, "runAfter": { "Compose_Days": ["Succeeded"] }, "actions": {
                "Reset_ContDay": { "type": "SetVariable", "inputs": { "name": "varContDay", "value": "" }, "runAfter": {} },
                "Reset_Seen": { "type": "SetVariable", "inputs": { "name": "varSeen", "value": [] }, "runAfter": { "Reset_ContDay": ["Succeeded"] } },
                "Until_Day": { "type": "Until", "expression": "@equals(empty(variables('varContDay')), true)", "limit": { "count": 1000, "timeout": "PT1H" }, "runAfter": { "Reset_Seen": ["Succeeded"] }, "actions": {
                  "Page_Day": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "GET", "request/url": "@{concat('https://licensing.powerplatform.microsoft.com/v2.0/tenants/', outputs('Compose_Tenant_Id'), '/entitlements/MCSMessages/resources?fromDate=', items('Apply_to_each_Day'), '&toDate=', items('Apply_to_each_Day'), '&includeFields=users,tags,asOfDate&orderByConsumed&continuationtoken=', variables('varContDay'))}" }, "authentication": "@parameters('$authentication')" }, "runAfter": {} },
                  "Objs_Day": { "type": "Select", "inputs": { "from": "@coalesce(first(body('Page_Day')?['value'])?['resources'], json('[]'))", "select": { "cat_rowkey": "@guid()", "cat_agentdetail_name": "@coalesce(item()?['metadata']?['ResourceName'], item()?['resourceId'])", "cat_loadbatch": "daily", "cat_lookbackdays": 1, "cat_agentid": "@item()?['resourceId']", "cat_agentname": "@coalesce(item()?['metadata']?['ResourceName'], item()?['resourceId'])", "cat_environmentid": "@item()?['environmentId']", "cat_environmentname": "@coalesce(variables('varEnvMap')?[item()?['environmentId']], '')", "cat_billedcredit": "@coalesce(item()?['consumed'], 0)", "cat_nonbilledcredit": "@coalesce(item()?['metadata']?['NonBillableQuantity'], 0)", "cat_channel": "@item()?['metadata']?['ChannelId']", "cat_feature": "@item()?['metadata']?['FeatureName']", "cat_tool": "@item()?['metadata']?['ToolInvoked']", "cat_llmmodel": "@item()?['metadata']?['LLMModel']", "cat_knowledgesources": "@item()?['metadata']?['KnowledgeSources']", "cat_users": "@coalesce(item()?['metadata']?['Users'], 0)", "cat_reportdate": "@items('Apply_to_each_Day')", "cat_sourcedate": "@outputs('Compose_Batch')", "cat_sourcefilename": "v2.0/MCSMessages/resources/1d" } }, "runAfter": { "Page_Day": ["Succeeded"] } },
                  "Filter_New": { "type": "Query", "inputs": { "from": "@body('Objs_Day')", "where": "@not(contains(variables('varSeen'), concat(item()?['cat_reportdate'],'|',item()?['cat_agentid'],'|',item()?['cat_environmentid'],'|',coalesce(item()?['cat_feature'],''),'|',coalesce(item()?['cat_tool'],''),'|',coalesce(item()?['cat_llmmodel'],''),'|',coalesce(item()?['cat_channel'],''),'|',coalesce(item()?['cat_knowledgesources'],''),'|',string(item()?['cat_billedcredit']),'|',string(item()?['cat_nonbilledcredit']),'|',string(item()?['cat_users']))))" }, "runAfter": { "Objs_Day": ["Succeeded"] } },
                  "Keys_New": { "type": "Select", "inputs": { "from": "@body('Filter_New')", "select": "@concat(item()?['cat_reportdate'],'|',item()?['cat_agentid'],'|',item()?['cat_environmentid'],'|',coalesce(item()?['cat_feature'],''),'|',coalesce(item()?['cat_tool'],''),'|',coalesce(item()?['cat_llmmodel'],''),'|',coalesce(item()?['cat_channel'],''),'|',coalesce(item()?['cat_knowledgesources'],''),'|',string(item()?['cat_billedcredit']),'|',string(item()?['cat_nonbilledcredit']),'|',string(item()?['cat_users']))" }, "runAfter": { "Filter_New": ["Succeeded"] } },
                  "If_Rows_Day": { "type": "If", "expression": { "and": [ { "greater": [ "@length(body('Filter_New'))", 0 ] } ] }, "runAfter": { "Keys_New": ["Succeeded"] }, "actions": {
                    "Parts_Day": { "type": "Select", "inputs": { "from": "@body('Filter_New')", "select": "@concat('--changesetB', outputs('Compose_CRLF'), 'Content-Type: application/http', outputs('Compose_CRLF'), 'Content-Transfer-Encoding: binary', outputs('Compose_CRLF'), 'Content-ID: ', guid(), outputs('Compose_CRLF'), outputs('Compose_CRLF'), 'POST ', outputs('Compose_Org'), '/api/data/v9.2/cat_agentdetails HTTP/1.1', outputs('Compose_CRLF'), 'Content-Type: application/json;type=entry', outputs('Compose_CRLF'), outputs('Compose_CRLF'), string(item()))" }, "runAfter": {} },
                    "Body_Day": { "type": "Compose", "inputs": "@concat('--batchB', outputs('Compose_CRLF'), 'Content-Type: multipart/mixed; boundary=changesetB', outputs('Compose_CRLF'), outputs('Compose_CRLF'), join(body('Parts_Day'), outputs('Compose_CRLF')), outputs('Compose_CRLF'), '--changesetB--', outputs('Compose_CRLF'), '--batchB--')", "runAfter": { "Parts_Day": ["Succeeded"] } },
                    "Post_Day": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_webcontents_2", "operationId": "InvokeHttp", "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents" }, "parameters": { "request/method": "POST", "request/url": "@{concat(outputs('Compose_Org'), '/api/data/v9.2/$batch')}", "request/headers": { "Content-Type": "multipart/mixed; boundary=batchB" }, "request/body": "@outputs('Body_Day')" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Body_Day": ["Succeeded"] } }
                  }, "else": { "actions": {} } },
                  "Set_SeenTmp": { "type": "SetVariable", "inputs": { "name": "varSeenTmp", "value": "@union(variables('varSeen'), body('Keys_New'))" }, "runAfter": { "If_Rows_Day": ["Succeeded"] } },
                  "Update_Seen": { "type": "SetVariable", "inputs": { "name": "varSeen", "value": "@variables('varSeenTmp')" }, "runAfter": { "Set_SeenTmp": ["Succeeded"] } },
                  "SetCont_Day": { "type": "SetVariable", "inputs": { "name": "varContDay", "value": "@coalesce(body('Page_Day')?['continuationtoken'], '')" }, "runAfter": { "Update_Seen": ["Succeeded"] } }
                } }
              } }
            } }
          }
        },
        "Set_Status_Success": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_syncmetadatas", "recordId": "@{outputs('Compose_Sync_Id')}", "item/cat_lastsyncstatus": 1, "item/cat_lastsyncmessage": "Agent sync OK (daily incremental, 7-day overlap)", "item/cat_lastsyncedat": "@utcNow()" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Process": ["Succeeded"] } },
        "Compose_Capacity_AsOf": { "type": "Compose", "inputs": "@if(empty(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['lastUpdatedOn']), formatDateTime(utcNow(), 'yyyy-MM-dd'), formatDateTime(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['lastUpdatedOn'], 'yyyy-MM-dd'))", "runAfter": { "Set_Status_Success": ["Succeeded"] } },
        "Create_Capacity_Row": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "CreateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_tenantcapacities", "item/cat_tenantcapacity_name": "@{concat('MCSMessages ', outputs('Compose_Capacity_AsOf'))}", "item/cat_capacitytype": "MCSMessages", "item/cat_unit": "@{body('Get_Capacity_MCS')?['entitlement']?['unit']}", "item/cat_entitled": "@coalesce(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['entitled']?['value'], 0)", "item/cat_consumed": "@coalesce(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['value'], 0)", "item/cat_allocated": "@coalesce(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['allocated']?['value'], 0)", "item/cat_available": "@coalesce(body('Get_Capacity_MCS')?['entitlement']?['capacity']?['availableQuantity'], 0)", "item/cat_paygoconsumed": "@coalesce(body('Get_Capacity_MCS')?['entitlement']?['payGo']?['consumed']?['value'], 0)", "item/cat_status": "@{body('Get_Capacity_MCS')?['entitlement']?['capacity']?['status']}", "item/cat_asofdate": "@body('Get_Capacity_MCS')?['entitlement']?['capacity']?['consumed']?['lastUpdatedOn']", "item/cat_capturedon": "@utcNow()", "item/cat_rowkey": "@{concat('MCSMessages_', outputs('Compose_Capacity_AsOf'))}" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Compose_Capacity_AsOf": ["Succeeded"] } },
        "Set_Status_Failed": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "cat_syncmetadatas", "recordId": "@{outputs('Compose_Sync_Id')}", "item/cat_lastsyncstatus": 2, "item/cat_lastsyncmessage": "Agent sync failed", "item/cat_lastsyncedat": "@utcNow()" }, "authentication": "@parameters('$authentication')" }, "runAfter": { "Process": ["Failed", "TimedOut"] } }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
